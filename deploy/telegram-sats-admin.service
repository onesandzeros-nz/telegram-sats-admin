[Unit]
Description=Telegram sats admin bot (Lightning paywall for group joins)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=satsadmin
Group=satsadmin
WorkingDirectory=/opt/telegram-sats-admin
EnvironmentFile=/etc/telegram-sats-admin.env
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/node src/index.ts
# Always come back after a crash, but stop (not loop) when the env file is invalid: exit 78 = EX_CONFIG.
Restart=always
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/telegram-sats-admin
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
