# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Breez SDK API key (request one at https://breez.technology/request-api-key/)
BREEZ_API_KEY=

# 12 or 24 word BIP39 mnemonic for the bot's Spark wallet.
# Generate one with:  npm run mnemonic
# Back this up: it is the only key to the sats the bot collects.
BREEZ_MNEMONIC=

# --- optional ---------------------------------------------------------------
# mainnet | regtest | signet
# BREEZ_NETWORK=mainnet
# Entry fee charged to each new member, in sats
# ENTRY_FEE_SATS=1000
# How long an issued invoice stays valid, in seconds (default 24h)
# INVOICE_EXPIRY_SECS=86400
# Where the bot keeps its SQLite database and wallet state
# DATA_DIR=./data
# Breez SDK log filter, e.g. "info" or "breez_sdk_spark=debug". Unset = SDK logs off.
# BREEZ_LOG_FILTER=info
